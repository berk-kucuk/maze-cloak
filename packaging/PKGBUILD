# Maintainer: berkkucukk <berkkucukk@proton.me>
#
# LOCAL-BUILD PKGBUILD.
# This builds maze-cloak from a source tarball generated out of the local
# working tree (see ../build-pkg.sh), NOT from a GitHub release tag. The build
# script writes the correct `pkgver` and drops `maze-cloak-$pkgver.tar.gz` next
# to this file before invoking makepkg.
#
# To publish to the AUR instead, swap the source line for the tagged release
# and replace 'SKIP' with the real checksum:
#   source=("$pkgname-$pkgver.tar.gz::https://github.com/berk-kucuk/maze-cloak/archive/refs/tags/v$pkgver.tar.gz")

pkgname=maze-cloak
pkgver=1.3.0
pkgrel=4
pkgdesc="Maze Cloak — MAC address randomisation with scheduled rotation for the Maze suite"
arch=('x86_64' 'aarch64')
url="https://github.com/berk-kucuk/maze-cloak"
license=('GPL3')

# PyQt6 comes from maze-python, the shared Maze venv at /opt/maze/venv.
# This package ships only its own code and runs it with that interpreter.
depends=(
    'maze-python'      # shared Python runtime: /opt/maze/venv
    'iproute2'         # `ip link set … address` — the actual MAC change
    'polkit'           # lets the maze group start/stop the daemon without a password
    'systemd'          # runs the rotation daemon
)
makedepends=(
    'imagemagick'      # resize app icon to multiple sizes during build
)
optdepends=(
    'ethtool: read the burned-in hardware address so it can be restored exactly'
    'networkmanager: per-connection and scan-time randomisation, and status reporting to other Maze tools'
)
install=maze-cloak.install

# The shipped policy defaults (see the config.json block in package()). It is a
# config file the admin and the GUI both write, so pacman must preserve local
# changes and leave a .pacnew instead of overwriting them.
backup=('etc/maze-cloak/config.json')

source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/maze-cloak-${pkgver}"

    # ── Application source → /opt/maze-cloak ───────────────────────────────
    install -dm755 "$pkgdir/opt/maze-cloak"
    cp -r mazecloak main.py "$pkgdir/opt/maze-cloak/"
    [[ -f pyproject.toml   ]] && install -m644 pyproject.toml   "$pkgdir/opt/maze-cloak/"
    [[ -f requirements.txt ]] && install -m644 requirements.txt "$pkgdir/opt/maze-cloak/"
    [[ -f MAZE-CLOAK.png   ]] && install -m644 MAZE-CLOAK.png   "$pkgdir/opt/maze-cloak/"

    # ── Launcher → /usr/bin/maze-cloak ─────────────────────────────────────
    install -dm755 "$pkgdir/usr/bin"
    install -m755 /dev/stdin "$pkgdir/usr/bin/maze-cloak" << 'LAUNCHER'
#!/usr/bin/env bash
exec /opt/maze/venv/bin/python3 /opt/maze-cloak/main.py "$@"
LAUNCHER

    # ── Shipped defaults → /etc/maze-cloak/config.json ─────────────────────
    # Without this file there is no config at all, load_config() falls back to
    # the dataclass defaults (enabled=False), and a user who never opens the
    # window gets NO randomisation — on a distribution whose whole point is
    # privacy, and for the two layers that cost nothing. Defaults are the only
    # setting most people ever use, so the default has to be the policy.
    #
    # Only the keys Maze deliberately differs on are listed. from_dict() drops
    # unknown keys and fills missing ones from the dataclass, so everything not
    # named here keeps tracking upstream instead of being frozen by a copy.
    #
    # Why these four:
    #   enabled=true         turns the tool on. It gates BOTH the NetworkManager
    #                        drop-in (rotator.sync_nm: `enabled and
    #                        nm_integration`) and rotation, so nothing happens
    #                        without it.
    #   rotate_enabled=false leaves TIMER rotation off. Changing a MAC while
    #                        connected takes the link down and up
    #                        (interfaces.py), i.e. the network drops — by
    #                        default every 30 minutes. That breaks captive
    #                        portals, DHCP reservations, long transfers and SSH
    #                        sessions, and it is the one layer a user should opt
    #                        into knowingly. The two free layers stay on.
    #   rotate_on_start=false is a SEPARATE switch and turning off the timer is
    #                        not enough on its own. Rotator.first_run() checks
    #                        `enabled` and `rotate_on_start` only — never
    #                        `rotate_enabled` — so leaving it at its default of
    #                        true would change the MAC through `ip link` once on
    #                        every boot. That is redundant here (scan-time and
    #                        per-network randomisation already come from the
    #                        NetworkManager drop-in) and it is a link down/up
    #                        during startup, so it is off too. With both off the
    #                        daemon never touches an interface at all: it writes
    #                        the drop-in, publishes status, and idles.
    #   nm_cloned_mode=stable a different address per NETWORK rather than a new
    #                        one per connection. Still unlinkable between access
    #                        points, which is the threat that matters, but
    #                        consistent within a network so portals and address
    #                        reservations keep working. This is what iOS and
    #                        Android ship, for the same reason.
    #
    # NOTE: the daemon removes the drop-in when it stops ("a claim that
    # randomisation is active must not outlive the daemon that makes it true"),
    # so maze-cloak.service has to be enabled for any of this to apply — that is
    # done in the ISO's enable-services.sh, not here.
    install -dm755 "$pkgdir/etc/maze-cloak"
    install -m644 /dev/stdin "$pkgdir/etc/maze-cloak/config.json" << 'CONFIG'
{
  "enabled": true,
  "rotate_enabled": false,
  "rotate_on_start": false,
  "nm_cloned_mode": "stable"
}
CONFIG

    # ── Rotation daemon (systemd) ──────────────────────────────────────────
    # Runs as root: changing a MAC address needs CAP_NET_ADMIN, and doing it
    # here rather than in the GUI is what keeps the GUI free of privilege.
    #
    # `-m mazecloak.daemon` rather than a path: running the file directly would
    # put /opt/maze-cloak/mazecloak on sys.path instead of /opt/maze-cloak, and
    # every `from mazecloak…` import would fail.
    #
    # RuntimeDirectory is correct here (unlike in maze-guard, where /run/maze is
    # shared with maze-tools): /run/maze-cloak belongs to this unit alone, and
    # having systemd delete it on stop is exactly the behaviour the GUI reads —
    # a missing state file means "not running".
    install -dm755 "$pkgdir/usr/lib/systemd/system"
    install -m644 /dev/stdin "$pkgdir/usr/lib/systemd/system/maze-cloak.service" << 'UNIT'
[Unit]
Description=Maze Cloak MAC randomisation daemon
Documentation=https://github.com/berk-kucuk/maze-cloak
After=network-pre.target
Wants=network-pre.target

[Service]
Type=simple
WorkingDirectory=/opt/maze-cloak
ExecStart=/opt/maze/venv/bin/python3 -m mazecloak.daemon
Restart=on-failure
RestartSec=3

RuntimeDirectory=maze-cloak
RuntimeDirectoryMode=0755
StateDirectory=maze-cloak
StateDirectoryMode=0700

# Conservative hardening. ProtectSystem stays 'true' rather than 'strict'
# because the daemon writes /etc/NetworkManager/conf.d — the drop-in that tells
# the rest of the Maze suite whether randomisation is on.
ProtectHome=true
ProtectSystem=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectHostname=true
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# Sandbox (2026-09): the daemon changes MACs over netlink (`ip link`), asks
# NetworkManager to reload over D-Bus and writes /etc/NetworkManager/conf.d —
# all kept. Taken away: module loading, kernel tunables, the clock, raw
# devices, realtime, foreign-ABI and non-service syscalls (EPERM, not a kill).
# Verify: sudo maze-sandbox-check   Relax locally: sudo systemctl edit maze-cloak
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
UNIT

    # ── polkit: the maze group may control this one unit, silently ─────────
    # Without it every Start/Stop click raises a password dialog. See the file
    # itself for why the grant is scoped the way it is.
    install -dm755 "$pkgdir/usr/share/polkit-1/rules.d"
    _rules="49-maze-cloak.rules"
    [[ -f "$_rules" ]] || _rules="packaging/49-maze-cloak.rules"
    install -m644 "$_rules" \
        "$pkgdir/usr/share/polkit-1/rules.d/49-maze-cloak.rules"

    # ── sysusers: the 'maze' group, shared with Maze Guard ─────────────────
    install -dm755 "$pkgdir/usr/lib/sysusers.d"
    install -m644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/maze-cloak.conf" << 'SYSUSERS'
g maze -
SYSUSERS

    # ── tmpfiles: /etc/maze-cloak, group-writable ──────────────────────────
    # This is what lets the GUI save settings without a password: the config is
    # root:maze 0664, so a maze-group member writes it directly and the daemon
    # picks the change up on its next tick.
    install -dm755 "$pkgdir/usr/lib/tmpfiles.d"
    install -m644 /dev/stdin "$pkgdir/usr/lib/tmpfiles.d/maze-cloak.conf" << 'TMPFILES'
d /etc/maze-cloak 0775 root maze -
# ...and the config INSIDE it. The directory line alone was not enough.
#
# config.json is created while the ISO is being built, so it carries whatever
# GID the 'maze' group happened to have in the airootfs. On the installed system
# that number is meaningless: Calamares removes the live 'maze' user, userdel
# takes its primary group with it, and systemd-sysusers recreates 'maze' with a
# different GID. The file is left owned by an orphaned numeric group, so a user
# who IS in 'maze' still cannot write their own settings — the directory looks
# right and the app fails anyway.
#
# 'z' adjusts an existing file's owner and mode and does nothing when it is
# absent, so this repairs machines already installed as well as new ones.
z /etc/maze-cloak/config.json 0664 root maze -
TMPFILES

    # ── .desktop entry (application menu) ──────────────────────────────────
    install -dm755 "$pkgdir/usr/share/applications"
    install -m644 /dev/stdin "$pkgdir/usr/share/applications/maze-cloak.desktop" << 'DESKTOP'
[Desktop Entry]
Version=1.0
Type=Application
Name=Maze Cloak
GenericName=MAC Address Randomisation
Comment=Randomise and rotate your network hardware address
Exec=/usr/bin/maze-cloak
Icon=maze-cloak
Terminal=false
Categories=Network;Security;System;Settings;
Keywords=mac;address;randomisation;randomization;privacy;anonymity;wifi;network;spoof;
StartupNotify=true
StartupWMClass=maze-cloak
X-GNOME-UsesNotifications=true
DESKTOP

    # ── Autostart entry (start hidden in the system tray on login) ─────────
    install -dm755 "$pkgdir/etc/xdg/autostart"
    install -m644 /dev/stdin "$pkgdir/etc/xdg/autostart/maze-cloak.desktop" << 'AUTOSTART'
[Desktop Entry]
Version=1.0
Type=Application
Name=Maze Cloak
GenericName=MAC Address Randomisation
Comment=Start Maze Cloak minimized in the system tray
Exec=/usr/bin/maze-cloak --background
Icon=maze-cloak
Terminal=false
Categories=Network;Security;System;
StartupNotify=false
StartupWMClass=maze-cloak
X-GNOME-Autostart-enabled=true
AUTOSTART

    # ── Icons ──────────────────────────────────────────────────────────────
    # -trim removes the ~10% transparent border the source artwork carries.
    # Without it the mark renders visibly smaller than every neighbouring icon,
    # because the panel adds its own padding on top of the padding already
    # baked into the file. +repage discards the offset -trim records, so the
    # resize that follows sees a clean canvas.
    if [[ -f MAZE-CLOAK.png ]]; then
        for size in 16 22 24 32 48 64 128 256 512; do
            install -dm755 "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
            _dest="$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/maze-cloak.png"
            if command -v magick &>/dev/null; then
                magick MAZE-CLOAK.png -trim +repage -resize "${size}x${size}" \
                    -background none -gravity center -extent "${size}x${size}" \
                    "$_dest" 2>/dev/null || install -m644 MAZE-CLOAK.png "$_dest"
            elif command -v convert &>/dev/null; then
                convert MAZE-CLOAK.png -trim +repage -resize "${size}x${size}" \
                    -background none -gravity center -extent "${size}x${size}" \
                    "$_dest" 2>/dev/null || install -m644 MAZE-CLOAK.png "$_dest"
            else
                install -m644 MAZE-CLOAK.png "$_dest"
            fi
        done
    fi

    # ── License ────────────────────────────────────────────────────────────
    install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
    [[ -f LICENSE ]] && install -m644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/"

    true
}
